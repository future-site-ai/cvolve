# Defaults for every environment. Override locally in .env.local (not committed).
# Real environment variables (e.g. from docker-compose) win over these files.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://cvolve:cvolve@127.0.0.1:5432/cvolve?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> cvolve ###
MAILER_FROM=no-reply@cvolve.local
# Users must click the link in the verification email before logging in
REQUIRE_EMAIL_VERIFICATION=1
# Generated PDFs/DOCX, profile photos, template fonts and thumbnails
STORAGE_DIR=%kernel.project_dir%/var/storage
GOTENBERG_URL=http://127.0.0.1:3000

# AI provider (Neuron AI): gemini | openai | anthropic | ollama | mistral | deepseek | grok | openai_like | none
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=
AI_BASE_URL=
###< cvolve ###
