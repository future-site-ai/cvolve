# Default settings for docker compose. Override any of them in .env.docker
# (copy .env.example). Do not edit this file for your own deployment.
APP_ENV=prod
APP_SECRET=change_me_to_a_random_32_char_hex
DEFAULT_URI=http://localhost:8080

POSTGRES_DB=cvolve
POSTGRES_USER=cvolve
POSTGRES_PASSWORD=cvolve
DATABASE_URL=postgresql://cvolve:cvolve@database:5432/cvolve?serverVersion=16&charset=utf8

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=no-reply@cvolve.local
REQUIRE_EMAIL_VERIFICATION=1
GOTENBERG_URL=http://gotenberg:3000
STORAGE_DIR=/var/www/html/var/storage

CVOLVE_SEED_DEMO=1
CVOLVE_ADMIN_EMAIL=admin@cvolve.local
CVOLVE_ADMIN_PASSWORD=admin1234

AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
