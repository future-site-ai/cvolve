<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; background: #f6f7f9; color: #17202c; margin: 0; padding: 24px; }
  .wrap { max-width: 520px; margin: 0 auto; background: #fff; border: 1px solid #e3e6eb; border-radius: 10px; padding: 28px; }
  h1 { font-size: 20px; margin: 0 0 12px; }
  .button { display: inline-block; background: #4f46e5; color: #fff !important; padding: 10px 18px; border-radius: 7px; text-decoration: none; font-weight: 600; }
  .muted { color: #7a8494; font-size: 13px; }
  .brand { font-weight: 700; color: #4f46e5; margin-bottom: 16px; }
</style></head>
<body><div class="wrap"><div class="brand">CVolve</div>{% block content %}{% endblock %}</div></body></html>
