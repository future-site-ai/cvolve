{% extends 'base.html.twig' %}
{% block title %}Log in{% endblock %}
{% block container_class %}container-narrow{% endblock %}
{% block body %}
    <div class="card">
        <h1>Log in</h1>
        <p class="muted">Welcome back to CVolve.</p>
        {% if error %}
            <div class="alert alert-error" style="margin-bottom:14px">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% if 'confirm your email' in error.messageKey %}
                <form method="post" action="{{ path('app_verify_resend') }}" style="margin-bottom:14px">
                    <input type="hidden" name="_token" value="{{ csrf_token('verify-resend') }}">
                    <input type="hidden" name="email" value="{{ last_username }}">
                    <button class="btn btn-sm">Resend the confirmation email</button>
                </form>
            {% endif %}
        {% endif %}
        <form method="post">
            <div class="form-row">
                <label for="email">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="email" autocomplete="email" required autofocus>
            </div>
            <div class="form-row">
                <label for="password">Password</label>
                <input type="password" name="password" id="password" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <div class="row" style="justify-content:space-between;margin-bottom:16px">
                <label class="checkbox-row" style="margin:0"><input type="checkbox" name="_remember_me"> <span>Remember me</span></label>
                <a href="{{ path('app_forgot_password_request') }}" class="small">Forgot password?</a>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Log in</button>
        </form>
        <hr>
        <p class="small muted" style="margin:0">No account yet? <a href="{{ path('app_register') }}">Sign up</a></p>
    </div>
{% endblock %}
