<div class="proposal {{ proposal.status }}" id="proposal-{{ proposal.id }}">
    <div class="proposal-head">
        <strong>{{ proposal.title }}</strong>
        {% if proposal.variant and proposal.variant.locale != proposal.cv.defaultLocale %}<span class="badge">{{ proposal.variant.locale|upper }}</span>{% endif %}
        {% if proposal.status == 'applied' %}<span class="badge badge-success">Applied</span>
        {% elseif proposal.status == 'discarded' %}<span class="badge">Discarded</span>
        {% else %}<span class="badge badge-primary">Review</span>{% endif %}
    </div>
    {% if proposal.description %}<div class="proposal-desc" style="padding-top:8px">{{ proposal.description }}</div>{% endif %}
    {% if proposal.pending %}
        <div class="proposal-body">
            {% for change in preview %}
                <div class="diff-label">{{ change.label }}</div>
                <div class="diff">
                    {% for row in change.diff|diff_compact %}<div class="{{ row.type }}">{{ row.line ?: ' ' }}</div>{% endfor %}
                </div>
            {% endfor %}
        </div>
        {% if error is defined and error %}<div class="alert alert-error" style="margin:0 12px 8px">{{ error }}</div>{% endif %}
        <div class="proposal-actions">
            <button type="button" class="btn btn-primary btn-sm" data-action="chat#resolve" data-url="{{ path('proposal_resolve', {id: proposal.id, action: 'apply'}) }}">Apply</button>
            <button type="button" class="btn btn-sm" data-action="chat#resolve" data-url="{{ path('proposal_resolve', {id: proposal.id, action: 'discard'}) }}">Discard</button>
            <span class="spacer"></span>
            <span class="small muted">{{ proposal.source }}</span>
        </div>
    {% endif %}
</div>
