# Docker deployment settings: copy to .env.docker and adjust (overrides docker/defaults.env).
# For running PHP locally instead, put the same keys in .env.local (see README).

APP_ENV=prod
# Generate with: php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=change_me_to_a_random_32_char_hex
# Public URL of the app (used in emails and MCP links)
DEFAULT_URI=http://localhost:8080

# PostgreSQL (docker-compose service "database")
POSTGRES_DB=cvolve
POSTGRES_USER=cvolve
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://cvolve:change_me@database:5432/cvolve?serverVersion=16&charset=utf8"

# Email: Mailpit catches everything in development (http://localhost:8025).
# Production example: smtp://user:pass@smtp.example.com:587
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=no-reply@cvolve.local
REQUIRE_EMAIL_VERIFICATION=1

GOTENBERG_URL=http://gotenberg:3000

# Create the admin (and the demo user) on first start: 1 = admin + demo, 0 = admin only
CVOLVE_SEED_DEMO=1
CVOLVE_ADMIN_EMAIL=admin@cvolve.local
CVOLVE_ADMIN_PASSWORD=admin1234

# ---------------------------------------------------------------------------
# AI provider (Neuron AI). Pick one; everything else in CVolve works without it.
#   gemini | openai | anthropic | ollama | mistral | deepseek | grok | openai_like | none
AI_PROVIDER=gemini
# Optional: model name (defaults: gemini-2.5-flash, gpt-4o-mini, claude-sonnet-5-5, llama3.1, ...)
AI_MODEL=
# API key for the chosen provider (or use GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY ...)
AI_API_KEY=your_api_key_here
# For ollama (default http://host.docker.internal:11434/api) or any OpenAI-compatible server
AI_BASE_URL=
